@model IEnumerable<(Cinema.Entities.Movie Movie, IEnumerable<Cinema.Entities.Seat> Seats)>

@{
    ViewData["Title"] = "Your Reserved Seats";
}

<div class="container mt-5">
    <h2 class="text-light text-center mb-4">Your Reserved Seats</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            You have not reserved any seats yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Movie</th>
                        <th scope="col">Reserved Seats</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Movie.Title</td>
                            <td>@string.Join(", ", item.Seats.Select(s => s.SeatNumber))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
