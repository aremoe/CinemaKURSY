@using Cinema.Entities
@model IEnumerable<Movie>

<h1>Favorite Movies</h1>

@if (!Model.Any())
{
    <p class="text-center text-muted">You have no favorite movies yet.</p>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary">Back to Movies</a>
}
else
{
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th scope="col">Cover</th>
                <th scope="col">Title</th>
                <th scope="col">Year</th>
                <th scope="col">Country</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>
                        <img src="@(!string.IsNullOrEmpty(movie.CoverImage) ? movie.CoverImage : "/images/placeholder.png")"
                             height="100"
                             alt="@movie.Title"
                             loading="lazy">
                    </td>
                    <td>
                        <a asp-controller="Favorites" asp-action="Details"
                           asp-route-id="@movie.Id"
                           asp-route-returnUrl="@Url.Action("Index", "Favorites")"
                           aria-label="View details for @movie.Title">
                            @movie.Title
                        </a>
                    </td>
                    <td>@movie.Year</td>
                    <td>@movie.Country</td>
                    <td>
                        <form asp-controller="Favorites" asp-action="Remove" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@movie.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Favorites")" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    title="Remove @movie.Title from Favorites"
                                    onclick="return confirm('Are you sure you want to remove @movie.Title from your favorites?');">
                                Remove from Favorites
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary mt-3">Back to Movies</a>
}
