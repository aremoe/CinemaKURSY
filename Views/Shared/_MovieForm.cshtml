@model Cinema.Entities.Movie

<div class="card movie-card bg-dark text-light shadow-lg me-3" style="width: 18rem; height: 28.2rem; margin-bottom: 1.5rem;">
    <div class="card-header">
        <img class="card-img" src="@Model.CoverImage" alt="@Model.Title" style="height: 20rem; object-fit: cover;" />
    </div>
    <div class="card-body d-flex flex-column justify-content-center">
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-info-square-fill"></i> Details
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash-fill"></i> Delete
            </a>
            <button onclick="addToFavorites(@Model.Id)" class="btn btn-outline-success btn-sm">
                <i class="bi bi-heart-fill"></i> Add to Favorites
            </button>
            <button onclick="removeFromFavorites(@Model.Id)" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-heartbreak-fill"></i> Remove from Favorites
            </button>
        </div>
    </div>
</div>
<script>
    function addToFavorites(movieId) {
        fetch(`/Favorites/Add?id=${movieId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                updateFavoriteCount();
            } else {
                console.error('Failed to add to favorites');
            }
        });
    }

    function removeFromFavorites(movieId) {
        fetch(`/Favorites/Remove?id=${movieId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                updateFavoriteCount();
            } else {
                console.error('Failed to remove from favorites');
            }
        });
    }
</script>
